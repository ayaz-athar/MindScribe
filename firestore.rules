rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny: Block all read/write by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for security validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Per-User Scoped Collections
    // Path: /users/{userId}
    match /users/{userId} {
      // User can only read and write their own root profile document
      allow read, write: if isOwner(userId);

      // Path: /users/{userId}/entries/{entryId}
      match /entries/{entryId} {
        // Enforce that only the authentic owner can read, create, update, or delete entries
        allow read: if isOwner(userId);
        
        allow create: if isOwner(userId) 
          && request.resource.data.userId == userId
          && request.resource.data.title is string
          && request.resource.data.content is string;

        allow update: if isOwner(userId)
          && request.resource.data.userId == userId;

        allow delete: if isOwner(userId);
      }

      // Path: /users/{userId}/insights/{insightId}
      match /insights/{insightId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
